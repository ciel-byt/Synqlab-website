# GSD Planning (local to each developer)
# Note: Existing .planning/ files remain tracked for historical record.
# New files in .planning/ will be ignored. Each developer's worktree
# has its own local planning state that won't conflict on merge.
# .planning/phases/
# .planning/quick/
# .planning/workstreams/
# .planning/debug/
# .planning/STATE.md
# .planning/config.json

# Claude settings (local to each developer)
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Runtime data (keep .gitkeep files)
data/models/**
!data/models/.gitkeep
!data/models/brightness/.gitkeep
!data/models/reranker/.gitkeep
data/knowledge/**
!data/knowledge/.gitkeep
data/user_media/**
!data/user_media/.gitkeep

# Agent artifact host mount — runtime files only, keep .gitkeep and bundled/
data/agent_artifacts/**
!data/agent_artifacts/.gitkeep
!data/agent_artifacts/bundled/
!data/agent_artifacts/bundled/**

# Tool binaries (FoldX, etc.) — tracked in git
!data/tools/
!data/tools/**

# Local config overrides (may contain secrets)
configs/local.yaml

# Built frontend assets — regenerated by `npm run build`, never commit
app/static/dist/

# Stale build/static dirs (superseded by frontend/ and data/)
/ui/
/models/

# macOS
.DS_Store

# Env files
.env
.env.*
!.env.example

# Terraform
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/terraform.tfvars
infra/terraform/crash.log
infra/terraform/override.tf
infra/terraform/override.tf.json

# Helm
deploy/helm/synqlab/charts/*.tgz
deploy/helm/synqlab/Chart.lock
tfplan
tfplan.out

# Scripts
scripts/.ops_pids.json
*tfplan*frontend/.vite/
