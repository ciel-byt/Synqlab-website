{
  "mode": "yolo",
  "granularity": "standard",
  "parallelization": true,
  "model_profile": "balanced",
  "planning": {
    "commit_docs": false,
    "search_gitignored": true
  },
  "git": {
    "branching_strategy": "phase",
    "phase_branch_template": "gsd/{user}-phase-{phase}-{slug}",
    "quick_branch_template": "gsd/{user}-quick-{num}-{slug}"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "discuss_mode": "discuss",
    "pattern_mapper": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "security_enforcement": false
  }
}
