# ─────────────────────────────────────────────────────────────────────────────
# SynqLab Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (required for production)
SYNQLAB_DB_URL=postgresql://synqlab:synqlab@localhost:5432/synqlab

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key for signing JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — a default insecure fallback is used in dev if unset.
SYNQLAB_JWT_SECRET=change-me-to-a-long-random-secret

# ── LLM / Chat ────────────────────────────────────────────────────────────────
# OpenAI API key — required for the chat assistant feature
OPENAI_API_KEY=sk-...

# Override the model used by the chat assistant (default: gpt-4o-mini)
# SYNQLAB_CHAT_MODEL=gpt-4o

# For custom OpenAI-compatible endpoints (e.g. Azure, local LLM proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Tool Services (optional — leave empty to use mock/stub mode) ──────────────
# Port assignments match docker-compose.yml model services.
# SYNQLAB_PROTGPT2_URL=http://localhost:8001
# SYNQLAB_OMEGAFOLD_URL=http://localhost:8002
# SYNQLAB_FOLDX_URL=http://localhost:8003
# SYNQLAB_RERANKER_URL=http://localhost:8004
# SYNQLAB_ESMFOLD_URL=http://localhost:8005
# SYNQLAB_PROTEINMPNN_URL=http://localhost:8006
# SYNQLAB_BRIGHTNESS_URL=http://localhost:8007
# SYNQLAB_BRIGHTNESS_MODEL_PATH=  # path to trained brightness model weights

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite dev server port (default: 5173)
# VITE_PORT=5173

# ── Email (future — for invite notifications) ─────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM=noreply@synqlab.ai
